# Multi-Agent AI SOC Environment Configuration Example

# Project Settings
PROJECT_NAME="Multi-Agent AI Security Operations Center (SOC)"
API_V1_STR=/api
SECRET_KEY=CHANGE_THIS_SECRET_KEY_FOR_PRODUCTION_ROYAL_ENTERPRISE_SOC_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default; PostgreSQL supported)
DATABASE_URL=sqlite:///./soc_enterprise.db
# DATABASE_URL=postgresql://soc_user:password@localhost:5432/soc_db

# Optional LLM Integration (Fallback to local high-fidelity deterministic engine if empty)
LLM_PROVIDER=local
GEMINI_API_KEY=
OPENAI_API_KEY=

# Engine Behavior
DEMO_MODE_DEFAULT=true
DEFAULT_RISK_THRESHOLD_AUTO_CONTAIN=85
