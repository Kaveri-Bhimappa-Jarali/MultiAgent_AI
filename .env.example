# Multi-Agent AI SOC Environment Configuration Example

# Project Settings
PROJECT_NAME="Multi-Agent AI Security Operations Center (SOC)"
API_V1_STR=/api
SECRET_KEY=CHANGE_THIS_SECRET_KEY_FOR_PRODUCTION_ROYAL_ENTERPRISE_SOC_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default; PostgreSQL supported)
DATABASE_URL=sqlite:///./soc_enterprise.db
# DATABASE_URL=postgresql://soc_user:password@localhost:5432/soc_db

# Optional LLM Integration (Fallback to local high-fidelity deterministic engine if empty)
LLM_PROVIDER=local
GEMINI_API_KEY=
OPENAI_API_KEY=

# Engine Behavior
DEMO_MODE_DEFAULT=true
DEFAULT_RISK_THRESHOLD_AUTO_CONTAIN=85

# Attacker VM Configuration
ATTACKER_VM_HOST=YOUR_ATTACKER_VM_PUBLIC_IP
ATTACKER_VM_PRIVATE_IP=10.0.0.13
ATTACKER_VM_USER=ubuntu
ATTACKER_VM_SSH_PORT=22
ATTACKER_VM_SSH_KEY_PATH=/path/to/attacker_key.pem

# Victim VM Configuration
VICTIM_VM_HOST=YOUR_VICTIM_VM_PUBLIC_IP
VICTIM_VM_PRIVATE_IP=10.0.0.14
VICTIM_VM_USER=ubuntu
VICTIM_VM_SSH_PORT=22
VICTIM_VM_INTERFACE=eth0

# Attack Simulation Configuration
ATTACK_SIMULATION_ENABLED=true
ATTACK_SIMULATION_MAX_CONCURRENT=1
ATTACK_SIMULATION_TIMEOUT=300
ATTACK_SIMULATION_ALLOWED_TARGETS=10.0.0.14
